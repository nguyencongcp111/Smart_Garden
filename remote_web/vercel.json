{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": { "api/*.js": { "maxDuration": 60 } },
  "rewrites": [
    { "source": "/api/gemini/v1beta/models/:model", "destination": "/api/gemini?model=:model" }
  ]
}
